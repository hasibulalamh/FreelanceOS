# ------------------------------------------------------------------
# FreelanceOS environment variables
# Copy to .env and fill in real values. NEVER commit .env or .env.local.
# ------------------------------------------------------------------

# --- Database --------------------------------------------------------
# PostgreSQL connection string (Prisma).
# Local dev: docker run -d --name freelanceos-pg \
#   -e POSTGRES_USER=freelanceos -e POSTGRES_PASSWORD=freelanceos_dev \
#   -e POSTGRES_DB=freelanceos -p 5433:5432 postgres:16-alpine
DATABASE_URL="postgresql://user:password@localhost:5433/freelanceos?schema=public"

# --- Authentication --------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# OAuth providers (optional). Buttons appear on the sign-in page only when
# both values of a provider are set. Leave empty to use email/password only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Portfolio sync --------------------------------------------------
# Base URL of the portfolio API (source of truth for profile data), e.g.
# https://hasibulalam.com. When empty, portfolio sync reports a "not
# configured" state instead of failing.
PORTFOLIO_API_URL=""

# Public portfolio URL, used for UI links only (safe to expose).
NEXT_PUBLIC_PORTFOLIO_URL="https://hasibulalam.com"
